{
  "name": "inkasso-defense",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligentes Analyse- & Kalkulations-Tool zur Prüfung unberechtigter Inkasso-Forderungen nach deutschem Verbraucherrecht.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "dev": "next dev",
    "build": "npm run build:css && next build",
    "start": "next start",
    "optimize:images": "node scripts/optimize-blog-images.cjs --delete",
    "test": "vitest run"
  },
  "engines": {
    "node": "22.x"
  },
  "keywords": [
    "inkasso",
    "verbraucherrecht",
    "anthropic",
    "claude",
    "ocr"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "gray-matter": "^4.0.3",
    "next": "^16.2.7",
    "next-mdx-remote": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "vitest": "^4.1.8"
  }
}
